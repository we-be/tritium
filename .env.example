# Copy to .env; tritium loads it on start. Exported environment variables win.

# Where this node accepts clients and peers. It speaks RESP, so point
# valkey-cli, redis-py or any Redis client here.
LISTEN_ADDRESS=localhost:8080

# What peers dial to reach this node; defaults to the bound address.
# Set it when LISTEN_ADDRESS binds a wildcard or a container-internal address.
#ADVERTISE_ADDRESS=10.0.0.5:8080

# An existing node to join. Leave unset to seed a new cluster.
#JOIN_ADDRESS=10.0.0.4:8080,10.0.0.5:8080   # every node can list every other; itself is skipped

# A peer that cannot dial us back (behind NAT, on another network). We open
# the connections and are served over them instead of joining normally; see
# docs/cloud.md. Comma-separated and joined the same way as JOIN_ADDRESS.
#LINK_ADDRESS=tritium.example.com:8080

# Password clients must AUTH with.
#AUTH_PASSWORD=change-me

# Password nodes present to each other (AUTH peer <password>); every node in a
# cluster shares it. Defaults to AUTH_PASSWORD, which lets any client join the
# cluster, so set it.
#PEER_PASSWORD=change-me-too

# A client that gets less than AUTH_PASSWORD: USER_<name>=<password>:<rights>,
# rights being ";"-separated <r|w|rw>:<key-or-prefix>[,...] clauses; an entry
# ending in ":" or "/" covers everything under it, any other names one key.
# See docs/cloud.md. USERS_FILE names a file of the same entries, one per
# line, with the bare name to the left of "="; AUTH_USER picks one of them
# for a client next to this node (-config) to authenticate as. In the
# process environment the entry is TRITIUM_USER_<name>.
#USER_gateway=change-me-too:rw:node:gateway,sig:gateway,sig:gateway:;r:board:,fleet,node:,id:
#USERS_FILE=/etc/tritium/users
#AUTH_USER=gateway

# The only addresses this node takes as peers; gossip naming any other is
# ignored. Set it on every node of a fleet reachable from the internet.
#PEER_ALLOW=10.0.0.4:8080,10.0.0.5:8080

# Unset, the node runs its own in-memory store. Set an address to write
# through an external RESP server (Valkey, Redis, Garnet...) instead, with its
# password if it has one; the same password is used for every replica.
# Without SECURE_STORE_TLS this connection is plaintext, so the store must be
# loopback or on the same container network — never reachable over a WAN.
#SECURE_STORE_ADDRESS=localhost:6379
#SECURE_STORE_PASSWORD=
#SECURE_STORE_TLS=false
#SECURE_STORE_CA=/etc/tritium/store-ca.pem
#SECURE_STORE_SERVER_NAME=

# Bytes the embedded store keeps (256M, 1G); past it the soonest-expiring
# keys are evicted. Unset means no limit.
#STORE_MAX_MEMORY=256M

# Connections pooled per RESP server
MAX_SERVER_CONNECTIONS=4

# Connections the node accepts at once; more are refused. A connection that
# does not AUTH within 10 s, or fails AUTH five times, is closed.
#MAX_CLIENTS=10000

# Each key's writes go through its owner node (on, the default), so SET NX
# and write order hold across the cluster. off: write locally first.
#KEY_OWNERSHIP=on

# sync (default): a write answers once every peer has it. async: answers once
# the local store has it and feeds peers in order from a queue — costs a
# moment where a key written on one node isn't yet on another, buys a write
# that doesn't pay a WAN round trip. Usually set per node, not fleet-wide.
#REPLICATION=sync

# TLS. With a certificate and key the node serves TLS and dials peers with
# TLS, presenting the same certificate. TLS_CA is what peers (and clients,
# when TLS_CLIENT_AUTH is true) must chain to; unset means the system roots.
#TLS_CERT=/etc/tritium/node.pem
#TLS_KEY=/etc/tritium/node-key.pem
#TLS_CA=/etc/tritium/ca.pem
#TLS_CLIENT_AUTH=false
