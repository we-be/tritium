# Copy to .env; tritium loads it on start. Exported environment variables win.

# Where this node accepts clients and peers. It speaks RESP, so point
# valkey-cli, redis-py or any Redis client here.
LISTEN_ADDRESS=localhost:8080

# What peers dial to reach this node; defaults to the bound address.
# Set it when LISTEN_ADDRESS binds a wildcard or a container-internal address.
#ADVERTISE_ADDRESS=10.0.0.5:8080

# An existing node to join. Leave unset to seed a new cluster.
#JOIN_ADDRESS=10.0.0.4:8080

# Password clients and peers must AUTH with. Every node in a cluster shares it.
#AUTH_PASSWORD=change-me

# RESP server (Valkey, Redis, Garnet...) this node writes through, and its
# password if it has one. The same password is used for every replica.
SECURE_STORE_ADDRESS=localhost:6379
#SECURE_STORE_PASSWORD=

# Connections pooled per RESP server
MAX_SERVER_CONNECTIONS=4

# TLS. With a certificate and key the node serves TLS and dials peers with
# TLS, presenting the same certificate. TLS_CA is what peers (and clients,
# when TLS_CLIENT_AUTH is true) must chain to; unset means the system roots.
#TLS_CERT=/etc/tritium/node.pem
#TLS_KEY=/etc/tritium/node-key.pem
#TLS_CA=/etc/tritium/ca.pem
#TLS_CLIENT_AUTH=false
